{
  "name": "civil-servant-protect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Civil Servant Protect \u2014 the member app, the member web app and the sponsor console.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "smoke": "node tests/smoke.mjs",
    "a11y": "node tests/a11y.mjs",
    "test:rails": "node tests/rails.mjs",
    "test": "npm run test:csv && npm run smoke && npm run test:rails && npm run test:layout && npm run a11y",
    "test:csv": "node --experimental-strip-types --no-warnings tests/csv.mjs",
    "test:layout": "node tests/layout.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "@phosphor-icons/web": "^2.1.1",
    "@tanstack/react-query": "^5.103.1",
    "@tanstack/react-query-devtools": "^5.103.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
