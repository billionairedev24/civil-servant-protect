# What `npm run dev` points at.
#
# The API, because a developer running this repo is running the API — and the
# alternative default cost somebody a review: they opened the app, saw the same
# figures the design bundle has always shown, and concluded that nothing was
# integrated. They were right about what they were looking at. Fixtures were the
# default, so the build they ran never called the backend once.
#
# Fixtures are still one command away, and are still what the design review and
# the rail-branching tests use:
#
#     VITE_API_URL= npm run dev      # fixtures, no backend needed
#
# The console additionally needs Keycloak for its sign-in door; without
# VITE_OIDC_ISSUER it says so rather than offering a button that goes nowhere.
VITE_API_URL=http://localhost:8080
