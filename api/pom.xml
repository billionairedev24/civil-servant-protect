<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>ng.csp</groupId>
  <artifactId>csp-api</artifactId>
  <version>0.1.0</version>
  <name>csp-api</name>
  <description>Civil Servant Protect — the API the member app, member web app and sponsor console all read.</description>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>25</maven.compiler.release>
    <resilience4j.version>2.4.0</resilience4j.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.8.13</springdoc.version>
    <!--
      The S3 client, for claim evidence and roll files. Version pinned here
      rather than taken from a BOM: Spring Boot manages neither, and an object
      store holding death certificates is not somewhere to discover a transitive
      upgrade.
    -->
    <awssdk.version>2.54.20</awssdk.version>
    <!-- OpenPGP. Spring Boot's BOM manages no BouncyCastle artefact, so the
         version is ours to pin; bcpg brings a matching bcprov and bcutil with
         it, which is what wants to stay matched — a bcpg against a different
         bcprov fails at provider registration, not at compile time. -->
    <bouncycastle.version>1.82</bouncycastle.version>
    <!-- QR encoding for the protection card. Server-side only: see CardQr for
         why the phone does not do this itself. -->
    <zxing.version>3.5.3</zxing.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!--
      JdbcClient rather than JPA. The ledger is append-only and the reconciliation
      queries are set-based; an ORM would hide exactly the SQL that has to be
      reviewable, and lazy loading has no place in a money path.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
      Spring Boot 4 split autoconfiguration into per-technology modules, so
      flyway-core alone is on the classpath but nothing wires it up. Without
      spring-boot-flyway the app starts against an empty schema and fails on the
      first query — which is exactly how this was found.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-flyway</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Resource server, for HS256 access tokens minted and verified here. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>

    <!-- Redis: OTP challenges, rate limits, console sessions (build spec). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>

    <!--
      Maker-checker lives in one aspect layer rather than in every handler.
      Spring Boot 4 dropped spring-boot-starter-aop; spring-aop arrives with the
      web starter, so only the AspectJ annotations are needed here.
    -->
    <dependency>
      <groupId>org.aspectj</groupId>
      <artifactId>aspectjweaver</artifactId>
    </dependency>

    <!--
      Spring Batch, for the schedule load.

      A payroll schedule is up to a million rows and the job has to survive a
      restart in the middle of one. That is what Batch's chunk boundaries and
      job repository are for, and writing a worse version of them by hand is the
      more expensive option.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
    </dependency>

    <!--
      Resilience4j, as libraries rather than as its Spring Boot starter.

      The starter is published for Boot 3 and pulls `spring-boot-starter-aop`,
      which Boot 4 no longer publishes; its annotation-driven aspects would also
      hide where the circuit breakers are. There are four external systems, each
      called from one place, so the decorators are applied explicitly in
      Resilient.java where they can be read.
    -->
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-circuitbreaker</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-retry</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-timelimiter</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.resilience4j</groupId>
      <artifactId>resilience4j-micrometer</artifactId>
      <version>${resilience4j.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Tests run against a real Postgres and Redis, supplied by the environment
      (docker compose locally, `services:` in GitLab CI). The rules that matter
      here — append-only, RLS by rail, the share sum, the hash chain — live in
      the database, and an in-memory stand-in would test none of them.
    -->
    <!--
      S3, not a vendor SDK. The spec says S3-compatible so that MinIO, Ceph or a
      provider's own store are all the same code — sovereignty means being able
      to move, and a client written against one vendor's API cannot.
    -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
      <exclusions>
        <!-- Netty comes with the async client, which this does not use. -->
        <exclusion>
          <groupId>software.amazon.awssdk</groupId>
          <artifactId>netty-nio-client</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!--
      OpenPGP, for the detached signature over a roll file.

      The spec asks for PGP by name, and for once the format matters more than
      the algorithm: an auditor verifying what a payroll sent should be able to
      do it with gpg on their own machine and a published public key, without
      this project handing them a bespoke tool. That rules out a JWS, which is
      otherwise the obvious choice and which nobody outside a developer can
      check.
    -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpg-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- QR encoding for the protection card. See CardQr. -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!--
      The decoder's bridge to a BufferedImage, for tests only.

      `core` has the reader; reading one out of an actual image file is in
      `javase`. It is test scope because that is the only place it belongs — the
      service encodes and never scans — but the test it enables is the one that
      matters: encode a card, read the picture back, and check a scanner gets
      the token we signed. An encoder checked against its own matrix proves the
      matrix is self-consistent and nothing else.
    -->
    <dependency>
      <groupId>com.google.zxing</groupId>
      <artifactId>javase</artifactId>
      <version>${zxing.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <!-- Record component and constructor parameter names reach the
                 validation messages and the JSON binder. -->
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
