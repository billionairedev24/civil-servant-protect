{
  "name": "csp-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "apk": "cd android && ./gradlew assembleRelease",
    "ios": "react-native run-ios",
    "pods": "cd ios && pod install",
    "apk:throwaway": "keytool -genkeypair -v -keystore /tmp/csp-throwaway.jks -alias throwaway -keyalg RSA -keysize 2048 -validity 30 -storepass throwaway -keypass throwaway -dname \"CN=Civil Servant Protect throwaway, O=not for release\" 2>/dev/null; cd android && ./gradlew assembleRelease -PCSP_UPLOAD_STORE_FILE=/tmp/csp-throwaway.jks -PCSP_UPLOAD_STORE_PASSWORD=throwaway -PCSP_UPLOAD_KEY_ALIAS=throwaway -PCSP_UPLOAD_KEY_PASSWORD=throwaway"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.2",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-image-picker": "^8.2.1",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
